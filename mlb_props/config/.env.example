# MLB Props Analyzer – environment overrides
# Copy this file to .env and edit as needed.
# The MLB Stats API is free and requires no API key.

# Override the analysis date (YYYY-MM-DD). Leave blank to use today.
ANALYSIS_DATE=

# Override season year
SEASON=2025

# Output directory (relative to project root)
OUTPUT_DIR=output

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Local timezone for game-time display
LOCAL_TIMEZONE=America/New_York
