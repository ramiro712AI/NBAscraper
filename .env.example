# ============================================================
# Market Scanner Pro — Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# cp .env.example .env

# ---- Crypto.com Exchange API ----
# Get from: https://crypto.com/exchange/user/account-management/account-api-management
# IMPORTANT: Use EXCHANGE keys, NOT crypto.com App keys (they are different)
CRYPTO_API_KEY=your_exchange_api_key_here
CRYPTO_SECRET_KEY=your_exchange_secret_key_here

# ---- Alert Delivery (optional) ----
# Telegram: create a bot via @BotFather and get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Webhook: any URL that accepts POST with JSON payload
ALERT_WEBHOOK_URL=

# Email alerts (uses SMTP)
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_TO=

# ---- Scanner Settings ----
CRYPTO_SCAN_INTERVAL=60       # seconds between auto-refresh
STOCK_SCAN_INTERVAL=120
BATCH_SIZE=20                  # symbols per batch

# ---- Database ----
DATABASE_URL=sqlite:///market_scanner.db

# ---- Logging ----
LOG_LEVEL=INFO
